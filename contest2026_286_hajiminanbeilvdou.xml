<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <project path="contest2026_286_hajiminanbeilvdou" name="contest2026_286_hajiminanbeilvdou">
    <!-- Agent voice UI application layer (screen + PTT + Chinese font).
         The remaining system-level code lives under src/ + docs/upstream/
         and is applied to the ai_agent / vendor_sifli / apps tree by
         patch (see docs/upstream/README.md) - it cannot be expressed as a
         linkfile because it lives inside the production repositories. -->
    <linkfile src="app/agent_voice" dest="packages/demos/contest2026_286_agent_voice"/>
  </project>
</manifest>
