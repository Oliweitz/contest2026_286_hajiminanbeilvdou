diff --git a/netutils/pppd/ipcp.c b/netutils/pppd/ipcp.c
index 56636998e..a2010e78b 100644
--- a/netutils/pppd/ipcp.c
+++ b/netutils/pppd/ipcp.c
@@ -311,6 +311,18 @@ void ipcp_rx(FAR struct ppp_context_s *ctx, FAR uint8_t * buffer,
 
       /* ppp_ipcp_state &= ~IPCP_RX_UP; */
 
+      /* Apply the acknowledged address to the interface.  Historically this
+       * only happened in the ConfNak path, so a peer that simply ACKs our
+       * ConfReq (i.e. a statically configured local address) left the
+       * interface unconfigured.
+       */
+
+      if (ctx->local_ip.s_addr != 0)
+        {
+          netlib_ifup((FAR char *)ctx->ifname);
+          netlib_set_ipv4addr((FAR char *)ctx->ifname, &ctx->local_ip);
+        }
+
       DEBUG1(("were up!\n"));
       printip(ctx->local_ip);
