+CONFIG_NETUTILS_CJSON=y
+#
+# 512 x 196B is ~100 KB of packet pool. The original 64 buffers (~12.5 KB) is
+# not enough for this board's own traffic -- a single LLM request carrying 36
+# tool definitions is ~15.8 KB -- and running out does not fail one request,
+# it stalls the whole interface. A continuous 8 KB/s audio stream over a
+# 1500 byte MTU wants the extra headroom.
